# === n8n 基礎設定 ===
# 資料庫密碼（自訂，任意字串）
POSTGRES_PASSWORD=change_me_db_password

# n8n 加密金鑰（32 位以上隨機字串，可用：openssl rand -hex 24）
N8N_ENCRYPTION_KEY=change_me_32char_encryption_key_here

# === API 金鑰（只需要兩個，都免費！）===

# Notion Internal Integration Token（免費）
# 取得方式：https://www.notion.so/my-integrations → 建立 integration → 複製 "Internal Integration Token"
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini API Key（免費，15 次/分鐘）
# 取得方式：https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic Claude API Key（免費額度）
# 取得方式：https://console.anthropic.com/ → API Keys
CLAUDE_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === 本地 AI（Ollama，完全免費，不需 API Key）===
# Ollama 需要單獨安裝在本機：https://ollama.com
# 安裝後執行：ollama pull qwen2.5:14b
# n8n 透過 Docker 網路自動連線到 Ollama，不需要額外設定
